<div class="jumbotron">
  <div class="container">
    <div class="row">
      <div class="col-md-5">
        <h1 style="font-size: 24px">
          <strong>TKM RandomX Mining Pool</strong>
        </h1>
        <strong>Min. payout threshold: {{config.PayoutThreshold}}</strong>, Payouts run automatically.<br/>
        <span class="label label-success">PROP</span> Stable RandomX pool with regular payouts.
      </div>
      <div class="col-md-3 stats">
        <div><i class="fa fa-users"></i> Miners Online: <span id="minersCount">{{model.minersTotal}}</span></div>
        <div><i class="fa fa-tachometer"></i> Pool Hash Rate: <span id="poolHashrate">{{model.hashrate}}</span></div>
        <div><i class="fa fa-money"></i> Pool Fee: <span id="poolFee" class="label label-success">{{config.PoolFee}}</span></div>
        {{#if model.stats.lastBlockFound}}
        <div><i class="fa fa-clock-o"></i> Last Block Found: <span>{{model.stats.lastBlockFound}}</span></div>
        {{/if}}
      </div>
      <div class="col-md-4 stats">
        <div><i class="fa fa-unlock-alt"></i> Network Difficulty: <span>{{model.nodes.firstObject.difficulty}}</span></div>
        <div><i class="fa fa-tachometer"></i> Network Hash Rate: <span>{{model.networkHashrate}}</span></div>
        <div><i class="fa fa-bars"></i> Blockchain Height: <span>{{model.nodes.firstObject.height}}</span></div>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="stats">
    <h4>Your Stats &amp; Payment History</h4>
    <div class="input-group">
      {{input value=cachedLogin class="form-control" placeholder="Enter Your TKM Wallet Address"}}
      <span class="input-group-btn">
        <button class="btn btn-primary" type="button" {{action 'lookup' cachedLogin}}>
          <i class="fa fa-search"></i> Lookup
        </button>
      </span>
    </div>
  </div>
  <div>
    <hr/>
    <h4 class="note note-info text-center">
      <strong>Stratum Connection:</strong> {{config.StratumHost}}:{{config.StratumPort}}<br/>
      <strong>Mining Command (XMRig):</strong><br/>
      xmrig --url stratum+tcp://{{config.StratumHost}}:{{config.StratumPort}} --address YOUR_WALLET --pass x --algo rx/0
    </h4>
  </div>
</div>
